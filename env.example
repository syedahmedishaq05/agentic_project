# =============================================
# AMARA - Environment Configuration
# =============================================
# Copy this file to .env and fill in your keys

# LLM API Keys (use at least one)
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Preferred LLM provider: "groq", "openai", or "anthropic"
LLM_PROVIDER=groq

# Groq model (if using Groq)
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI model (if using OpenAI)
OPENAI_MODEL=gpt-4o

# Anthropic model (if using Anthropic)
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Semantic Scholar API (free, optional but recommended)
SEMANTIC_SCHOLAR_API_KEY=

# Vector Store path
VECTOR_STORE_PATH=./data/faiss_index

# Max papers to retrieve per query
MAX_PAPERS=10

# Max chunks per paper for RAG
MAX_CHUNKS=5
